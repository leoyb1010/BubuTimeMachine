<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>top.leoyuan.bubu.weekly-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/BubuTimeMachine/server/ai/start_weekly_report.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <!-- launchd: 1=周日、2=周一；自然周结束后周一 00:05 再生成。 -->
    <key>Weekday</key><integer>2</integer>
    <key>Hour</key><integer>0</integer>
    <key>Minute</key><integer>5</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/BubuTimeMachine/server/logs/weekly-report.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/BubuTimeMachine/server/logs/weekly-report-error.log</string>
</dict>
</plist>

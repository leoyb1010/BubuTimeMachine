# chmod 600 ~/.config/bubu/backup.env
PB_DATA_DIR=/ABSOLUTE/PATH/pocketbase/pb_data
MIRROR_DIR=/Volumes/BubuBackup/BubuTimeMachine/pb_data_mirror
BACKUP_STAMP=/Users/YOU/Library/Application Support/BubuTimeMachine/backup-success
WORK_ROOT=/Users/YOU/Library/Caches/BubuTimeMachine
LOCK_DIR=/tmp/bubu-pb-backup.lock
NTFY_URL=http://127.0.0.1:8095/bubu-ops
NTFY_TOKEN_FILE=/Users/YOU/.config/bubu/ntfy-token
# RESTIC_REPOSITORY=s3:https://YOUR-R2-ENDPOINT/bubu-backup
# 可选第二仓库：例如 mini 已登录的 iCloud Drive 中的加密 restic 仓库。
# RESTIC_SECONDARY_REPOSITORY=/Users/YOU/Library/Mobile Documents/com~apple~CloudDocs/BubuTimeMachine/restic-offsite
# RESTIC_PASSWORD_FILE=/Users/YOU/.config/bubu/restic-password
# 正式环境设 true：任一仓库没配置或失败都不更新成功时间戳。
# REQUIRE_RESTIC_REPOSITORIES=true

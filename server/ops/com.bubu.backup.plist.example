<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bubu.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/ABSOLUTE/PATH/BubuTimeMachine/server/ops/backup_pb_data.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PB_DATA_DIR</key>
    <string>/ABSOLUTE/PATH/pocketbase/pb_data</string>
    <key>MIRROR_DIR</key>
    <string>/Volumes/BubuBackup/BubuTimeMachine/pb_data_mirror</string>
    <key>BACKUP_STAMP</key>
    <string>/Users/YOU/Library/Application Support/BubuTimeMachine/backup-success</string>
    <!-- 配好异地仓库后再取消下面四行注释，密码文件权限必须为 600。 -->
    <!-- <key>RESTIC_REPOSITORY</key> -->
    <!-- <string>s3:https://YOUR-R2-ENDPOINT/bubu-backup</string> -->
    <!-- <key>RESTIC_PASSWORD_FILE</key> -->
    <!-- <string>/Users/YOU/.config/bubu/restic-password</string> -->
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>17</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/BubuTimeMachine/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/BubuTimeMachine/backup-error.log</string>
</dict>
</plist>

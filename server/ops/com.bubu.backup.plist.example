<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bubu.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/ABSOLUTE/PATH/BubuTimeMachine/server/ops/run_scheduled_backup.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- 配置文件必须归当前用户所有且权限为 600；模板见 backup.env.example。 -->
    <!-- 正式环境必须在其中设置 REQUIRE_RESTIC_REPOSITORIES=true，并配置两个不同仓库。 -->
    <key>BUBU_BACKUP_CONFIG</key>
    <string>/Users/YOU/.config/bubu/backup.env</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>17</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/BubuTimeMachine/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/BubuTimeMachine/backup-error.log</string>
</dict>
</plist>

# 布布时光机 AI 服务 · 环境变量
# 复制为 .env 并填写。启动脚本会自动加载。

# DeepSeek（OpenAI 兼容协议）
# ⚠️ 填你自己的 key，绝不要把真实 key 提交到 git
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
LLM_TIMEOUT=60

# 语音转写（可选，需 pip install faster-whisper）
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# 服务端口
AI_PORT=8000

# 服务监听地址（默认只绑本机回环，最安全）。
# 需经 Tailscale/内网访问时改成该机的 Tailscale 地址（如 100.x.x.x），勿裸公网放 0.0.0.0。
BUBU_AI_BIND=127.0.0.1

# 成长电影下载白名单：/movie/render 只允许下载指向【自托管 PocketBase 主机】的图片，
# 防 SSRF/LFI（否则持 key 者可让服务端读 file:///etc/passwd 或探内网/云元数据）。
# 【可选】不填也能用：默认放行本机 PocketBase 127.0.0.1:8090 / localhost:8090（单机部署开箱即用），
# file:// / 外网 / 私网其它 IP / 本机其它端口一律照拦。
# 只有 Tailscale 或 PB 独立机部署时才需填成实际地址（含端口最精确）。
# 例：PB_BASE_URL=http://100.x.x.x:8090
PB_BASE_URL=
# 备选：只给 host 或 host:port（PB_BASE_URL 优先）。可逗号分隔多个。
# BUBU_PB_HOST=127.0.0.1:8090

# 服务鉴权（必填）：App 设置页「AI 访问密钥」填同一个值。
# 生成方式：openssl rand -hex 24
AI_API_KEY=

# 每个来源 IP 每分钟最多请求数（公网暴露时的最低防线）
AI_RATE_LIMIT_PER_MINUTE=30

# G1 语义搜图（默认关闭；索引是可重建派生数据，不放进 pb_data）
SEMANTIC_SEARCH_ENABLED=false
SEMANTIC_INDEX_PATH=../derived/memory_index.sqlite
SEMANTIC_MODEL_NAME=mobileclip_s0
SEMANTIC_MODEL_PATH=./models/mobileclip_s0/mobileclip_s0.pt
SEMANTIC_MODEL_VERSION=mobileclip-s0-datacompdr-1b
SEMANTIC_FAMILY_ID=
SEMANTIC_MIN_SCORE=0.52
SEMANTIC_WORKER_POLL_SECONDS=10
SEMANTIC_WORKER_LOCK=../derived/semantic-worker.lock
SEMANTIC_MAX_DOWNLOAD_BYTES=134217728
# 推荐：PocketBase 后台创建只给本机 worker 的长期 superuser token。
PB_WORKER_TOKEN=
# 兼容回退：没有 token 时才使用邮箱 + 密码。
PB_WORKER_EMAIL=
PB_WORKER_PASSWORD=

# G2 布布周报：服务端固定绑定一个家庭，客户端不能传 familyId 越权查询。
WEEKLY_REPORT_FAMILY_ID=
WEEKLY_REPORT_CHILD_NAME=布布
WEEKLY_REPORT_TIMEZONE=Asia/Shanghai
# 可选：只发送“周报已生成”的无正文通知。未部署 ntfy 时留空，不影响周报生成。
WEEKLY_REPORT_NTFY_URL=
WEEKLY_REPORT_NTFY_TOKEN=
